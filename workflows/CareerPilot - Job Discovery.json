    {
      "parameters": {
        "jsCode": "function decodeBase64Url(value) {\n  if (!value) return '';\n  const normalized = value.replace(/-/g, '+').replace(/_/g, '/');\n  return Buffer.from(normalized, 'base64').toString('utf8');\n}\n\nfunction extractParts(payload) {\n  let html = '', plain = '';\n  function walk(part) {\n    if (!part) return;\n    const mime = part.mimeType || '';\n    const data = part.body?.data;\n    if (data && !part.filename) {\n      const d = decodeBase64Url(data);\n      if (mime === 'text/html') html += d;\n      else if (mime === 'text/plain') plain += d;\n    }\n    for (const c of part.parts || []) walk(c);\n  }\n  walk(payload);\n  return { html, plain };\n}\n\n// Decode =?UTF-8?Q?...?= subjects\nfunction decodeSubject(s) {\n  if (!s) return '';\n  s = String(s).replace(/^Subject:\\s*/i, '').replace(/\\r?\\n\\s*/g, '');\n  s = s.replace(/=\\?UTF-8\\?Q\\?(.*?)\\?=/gi, (_, q) =>\n    Buffer.from(\n      q.replace(/_/g, ' ').replace(/=([0-9A-F]{2})/gi, (m, h) => String.fromCharCode(parseInt(h, 16))),\n      'binary'\n    ).toString('utf8')\n  );\n  return s.replace(/\\s+/g, ' ').trim();\n}\n\nfunction extractLinks(html) {\n  const links = [];\n  const re = /href=\"([^\"]+)\"/gi;\n  let m;\n  while ((m = re.exec(html)) !== null) links.push(m[1].replace(/&amp;/g, '&'));\n  return [...new Set(links)];\n}\n\nreturn $input.all().map(item => {\n  const e = item.json;\n  let html = '', text = '', layout = 'none';\n\n  if (e.html || e.text) {\n    html = typeof e.html === 'string' ? e.html : '';\n    text = typeof e.text === 'string' ? e.text : '';\n    layout = 'parsed (top-level html/text)';\n  } else if (e.payload) {\n    const b = extractParts(e.payload);\n    html = b.html; text = b.plain;\n    layout = 'gmail payload';\n  }\n\n  const fromRaw = typeof e.from === 'object' ? (e.from?.text || '') : (e.from || e.headers?.from || '');\n  const subjRaw = e.subject || e.headers?.subject || '';\n\n  return {\n    json: {\n      source: String(fromRaw).toLowerCase().includes('indeed') ? 'Indeed' : 'LinkedIn',\n      external_id: e.id,\n      email_subject: decodeSubject(subjRaw),\n      email_sender: String(fromRaw),\n      email_date: e.date || e.internalDate || '',\n      layout_found: layout,\n      top_level_keys: Object.keys(e).join(', '),\n      email_text_length: text.length,\n      email_html_length: html.length,\n      email_link_count: extractLinks(html).length,\n      email_text: text,\n      email_html: html,\n      imported_at: new Date().toISOString()\n    }\n  };\n});"
      },
