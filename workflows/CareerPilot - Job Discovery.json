      "name": "Fetch Arbeitnow Jobs"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst jobs = response.data || [];\n\nconst keywords = [\n  \"devops\",\n  \"site reliability\",\n  \"sre\",\n  \"cloud engineer\",\n  \"cloud infrastructure\",\n  \"aws\",\n  \"azure\",\n  \"google cloud\",\n  \"kubernetes\",\n  \"docker\",\n  \"linux\",\n  \"system administrator\",\n  \"systems administrator\",\n  \"network engineer\",\n  \"infrastructure engineer\",\n  \"platform engineer\",\n  \"it support\",\n  \"system engineer\",\n  \"technical support\",\n  \"wordpress\"\n];\n\nfunction cleanHtml(value = \"\") {\n  return value\n    .replace(/<[^>]*>/g, \" \")\n    .replace(/&nbsp;/g, \" \")\n    .replace(/&amp;/g, \"&\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nconst results = [];\n\nfor (const job of jobs) {\n  const title = job.title || \"\";\n  const description = cleanHtml(job.description || \"\");\n  const tags = Array.isArray(job.tags)\n    ? job.tags.join(\" \")\n    : \"\";\n\n  const searchable =\n    `${title} ${description} ${tags}`.toLowerCase();\n\n  const matchedKeywords = keywords.filter(keyword =>\n    searchable.includes(keyword)\n  );\n\n  if (matchedKeywords.length === 0) continue;\n\n  // Only accept explicitly remote roles or\n  // opportunities located in Karachi/Pakistan.\n  const location = job.location || \"Not specified\";\n\n  const isRemote = job.remote === true;\n\n  const isPakistan =\n    /karachi|pakistan/i.test(location);\n\n  if (!isRemote && !isPakistan) continue;\n\n  const externalId =\n    String(job.slug || job.url || job.id || \"\");\n\n  if (!externalId) continue;\n\n  results.push({\n    json: {\n      source: \"Arbeitnow\",\n      external_id: externalId,\n      title,\n      company: job.company_name || \"Unknown\",\n      location,\n      job_url: job.url || \"\",\n      description,\n      category: tags,\n      job_type: Array.isArray(job.job_types)\n        ? job.job_types.join(\", \")\n        : \"Not specified\",\n      salary: job.salary || \"Not specified\",\n      posted_at: job.created_at || \"\",\n      is_remote: isRemote,\n      matched_keywords: matchedKeywords.join(\", \"),\n      discovered_at: new Date().toISOString(),\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -176,
        -304
      ],
      "id": "291b6dfc-2b8c-4dcb-bcea-1ca6120e64d6",
      "name": "Format Arbeitnow Jobs"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst jobs = response.jobs || [];\n\nconst keywords = [\n  \"devops\",\n  \"site reliability\",\n  \"sre\",\n  \"cloud engineer\",\n  \"cloud infrastructure\",\n  \"aws\",\n  \"azure\",\n  \"google cloud\",\n  \"docker\",\n  \"linux\",\n  \"system administrator\",\n  \"systems administrator\",\n  \"network engineer\",\n  \"infrastructure engineer\",\n  \"platform engineer\",\n  \"it support\",\n  \"system engineer\",\n  \"technical support\",\n  \"wordpress\"\n];\n\nfunction cleanHtml(value = \"\") {\n  return value\n    .replace(/<[^>]*>/g, \" \")\n    .replace(/&nbsp;/g, \" \")\n    .replace(/&amp;/g, \"&\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nconst results = [];\n\nfor (const job of jobs) {\n  const title = job.title || \"\";\n  const description = cleanHtml(job.description || \"\");\n  const category = job.category || \"\";\n\n  const searchable = `${title} ${description} ${category}`\n    .toLowerCase();\n\n  const matchedKeywords = keywords.filter(keyword =>\n    searchable.includes(keyword)\n  );\n\n  if (matchedKeywords.length === 0) continue;\n\n  results.push({\n    json: {\n      source: \"Remotive\",\n      external_id: String(job.id),\n      title,\n      company: job.company_name || \"Unknown\",\n      location: job.candidate_required_location || \"Not specified\",\n      job_url: job.url || \"\",\n      description,\n      category,\n      job_type: job.job_type || \"Not specified\",\n      salary: job.salary || \"Not specified\",\n      posted_at: job.publication_date || \"\",\n      is_remote: true,\n      matched_keywords: matchedKeywords.join(\", \"),\n      discovered_at: new Date().toISOString(),\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
