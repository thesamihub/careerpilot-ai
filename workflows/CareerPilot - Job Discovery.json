        "jsCode": "const KEYWORDS = [\n  \"devops\",\"site reliability\",\"sre\",\"cloud engineer\",\"cloud infrastructure\",\n  \"cloud administrator\",\"cloud developer\",\"aws\",\"azure\",\"google cloud\",\n  \"kubernetes\",\"docker\",\"linux\",\"system administrator\",\"systems administrator\",\n  \"network engineer\",\"infrastructure engineer\",\"platform engineer\",\"it support\",\n  \"system engineer\",\"technical support\",\"kafka\",\"ci/cd\",\"terraform\",\"ansible\",\"wordpress\"\n];\n\nfunction matchKeywords(text) {\n  return KEYWORDS.filter(k => {\n    const esc = k.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n    return new RegExp('(^|[^a-z0-9])' + esc + '([^a-z0-9]|$)', 'i').test(text);\n  });\n}\n\nconst seen = new Map();\n\nfor (const item of $input.all()) {\n  const e = item.json;\n  // Accept standard Indeed source or generic email alert sources carrying Indeed text\n  if (!e.source || !e.source.toLowerCase().includes('indeed')) continue;\n\n  const emailContent = e.email_text || e.text || '';\n  const blocks = emailContent.split(/\\n\\s*\\n/);\n\n  for (const b of blocks) {\n    const lines = b.split('\\n').map(l => l.trim()).filter(Boolean);\n    \n    // Find any Indeed or Engage tracking URL in the block\n    const urlIdx = lines.findIndex(l => /(https:\\/\\/(?:[a-z.]*indeed\\.com\\/rc\\/clk|engage\\.indeed\\.com\\/f\\/a\\/))/i.test(l));\n    if (urlIdx < 1 || lines.length < 2) continue;\n\n    const urlLine = lines[urlIdx];\n    const title = lines[0];\n    const cl = lines[1] || '';\n    const idx = cl.lastIndexOf(' - ');\n    const company = idx > 0 ? cl.slice(0, idx) : cl;\n    const location = idx > 0 ? cl.slice(idx + 3) : '';\n\n    const jkMatch = urlLine.match(/[?&]jk=([a-z0-9]+)/i);\n    const jk = jkMatch\n      ? jkMatch[1]\n      : 'eng_' + (title + company + location).toLowerCase().replace(/[^a-z0-9]+/g, '').slice(0, 60);\n    if (seen.has(jk)) continue;\n\n    const rest = lines.slice(2, urlIdx);\n    const salary = rest.find(l => /^(From |Up to )?Rs\\s/i.test(l)) || '';\n    const posted = rest.find(l => /^(Just posted|Today|\\d+\\+? days? ago|\\d+ hours? ago)/i.test(l)) || '';\n    const snippet = rest\n      .filter(l => l !== salary && l !== posted && l !== 'Easily apply')\n      .join(' ');\n\n    const kws = matchKeywords(title + ' ' + snippet);\n\n    seen.set(jk, {\n      json: {\n        source: 'Indeed',\n        external_id: jk,\n        title,\n        company,\n        location,\n        job_url: jkMatch ? 'https://pk.indeed.com/viewjob?jk=' + jk : urlLine,\n        description: snippet,\n        category: '',\n        job_type: '',\n        salary,\n        posted_at: posted,\n        is_remote: /remote/i.test(title + ' ' + location + ' ' + snippet),\n        matched_keywords: kws.join(', '),\n        discovered_at: new Date().toISOString(),\n        status: 'new',\n        relevant: kws.length > 0\n      }\n    });\n  }\n}\n\nreturn [...seen.values()];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        224
      ],
      "id": "6a941b2d-00a3-4273-a891-122898c070af",
      "name": "Parse Indeed Alerts"
    },
    {
      "parameters": {
        "jsCode": "const KEYWORDS = [\n  \"devops\",\"site reliability\",\"sre\",\"cloud engineer\",\"cloud infrastructure\",\n  \"cloud administrator\",\"cloud developer\",\"aws\",\"azure\",\"google cloud\",\n  \"kubernetes\",\"docker\",\"linux\",\"system administrator\",\"systems administrator\",\n  \"network engineer\",\"infrastructure engineer\",\"platform engineer\",\"it support\",\n  \"system engineer\",\"technical support\",\"kafka\",\"ci/cd\",\"terraform\",\"ansible\",\"cloud support\",\"cloudops\",\"wordpress\"\n];\n\nfunction matchKeywords(text) {\n  return KEYWORDS.filter(k => {\n    const esc = k.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n    return new RegExp('(^|[^a-z0-9])' + esc + '([^a-z0-9]|$)', 'i').test(text);\n  });\n}\n\nconst NOISE = /(actively hiring|actively recruiting|new jobs from your other alerts|<strong|^your job alert|new jobs match|^manage alerts|^see all jobs)/i;\nconst seen = new Map();\nconst seenKey = new Set();\n\nfor (const item of $input.all()) {\n  const e = item.json;\n  if (e.source !== 'LinkedIn') continue;\n\n  let buf = [];\n  for (const raw of (e.email_text || '').split('\\n')) {\n    const line = raw.trim();\n    if (!line) continue;\n\n    if (/^-{5,}$/.test(line)) { buf = []; continue; }\n\n    const m = line.match(/^View job:\\s*(https?:\\/\\/\\S+)/i);\n    if (m) {\n      const idMatch = m[1].match(/\\/jobs\\/view\\/(\\d+)/);\n      if (idMatch && buf.length >= 3 && !seen.has(idMatch[1])) {\n        const [title, company, location] = buf.slice(-3);\n        const id = idMatch[1];\n        const key = (company + '|' + title + '|' + location).toLowerCase();\n        if (seenKey.has(key)) { buf = []; continue; }\n        seenKey.add(key);\n\n        const is_remote = /remote/i.test(title + ' ' + location);\n        const inPakistan = /karachi|pakistan/i.test(location);\n        const openRegion = /worldwide|global|anywhere|apac|asia/i.test(location);\n        const eligible = inPakistan || (is_remote && openRegion);\n        const kws = matchKeywords(title);\n\n        seen.set(id, { json: {\n          source: 'LinkedIn',\n          external_id: id,\n          title,\n          company,\n          location,\n          job_url: 'https://www.linkedin.com/jobs/view/' + id + '/',\n          description: '',\n          category: '',\n          job_type: '',\n          salary: '',\n          posted_at: '',\n          is_remote,\n          matched_keywords: kws.join(', '),\n          discovered_at: new Date().toISOString(),\n          status: 'new',\n          relevant: kws.length > 0 && eligible\n        }});\n      }\n      buf = [];\n      continue;\n    }\n\n    if (NOISE.test(line)) continue;\n    buf.push(line);\n  }\n}\n\nreturn [...seen.values()];"
      },
